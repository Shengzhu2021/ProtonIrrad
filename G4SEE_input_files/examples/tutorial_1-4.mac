########################################################
###       G4SEE Tutorial 1.4 - Scoring, SEE XS       ###
########################################################

#################
### General G4 commands

/run/printProgress                  1000
/run/numberOfThreads                4
/control/cout/ignoreThreadsExcept   0

/random/setSeeds                    1234, 4321  

/tracking/verbose                   0

#################
### Geometry

# BULK COMMAND                      MATERIAL            WIDTH unit  	THICK unit  	BIAS
/SEE/geometry/Bulk                  G4_Si               6 um            1 um            false
# SV COMMAND                        POSITION unit       WIDTH unit  	THICK unit  	BIAS
/SEE/geometry/SV                    0 0 0 nm            310 310 nm      310 nm          false
# BEOL COMMAND                      MATERIAL            WIDTH unit      THICK unit      NAME        BIAS
/SEE/geometry/BEOL/addLayer         G4_SILICON_DIOXIDE  6 um            6 um            Oxide       false

#################
### Initialize
/run/initialize

#################
### Primaries

/gps/particle                       proton
/gps/ene/mono                       1 MeV
/gps/ene/sigma                      25 keV
/gps/direction                      0 0 -1
/gps/pos/type                       Plane
/gps/pos/shape                      Rectangle
/gps/pos/centre                     0 0 10 um
/gps/pos/halfx                      0.5 um
/gps/pos/halfy                      0.5 um

#################
### Scoring (standard)

/SEE/scoring/standard/Ekin          0       proton
/SEE/scoring/setHistogram           lin     200     0       2   MeV

/SEE/scoring/standard/Edep          0
/SEE/scoring/setHistogram           log     300     0.0001  1   MeV

/SEE/scoring/dumpHistogramsAfter    10000

#################
### Run
/run/beamOn                         200000
